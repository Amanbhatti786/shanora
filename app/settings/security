'use client';

export const dynamic = 'force-dynamic';

import React, { useState, useEffect } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { supabase } from '../../../lib/supabaseClient';

export default function SecuritySettingsPage() {
  const router = useRouter();
  const [currentUser, setCurrentUser] = useState(null);
  const [loading, setLoading] = useState(true);

  // Password fields
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [passwordLoading, setPasswordLoading] = useState(false);
  const [passwordMsg, setPasswordMsg] = useState({ type: '', text: '' });

  // Security preferences & sessions
  const [emailAlerts, setEmailAlerts] = useState(true);
  const [singleSession, setSingleSession] = useState(true);
  const [sessions, setSessions] = useState([]);
  const [currentToken, setCurrentToken] = useState('');
  const [actionLoading, setActionLoading] = useState(false);

  useEffect(() => {
    async function loadSecurityData() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session?.user) {
          router.push('/auth');
          return;
        }

        setCurrentUser(session.user);
        const token = session.access_token.slice(-24);
        setCurrentToken(token);

        // Register current device session
        const nav = typeof window !== 'undefined' ? window.navigator : {};
        const deviceName = /mobile/i.test(nav.userAgent || '') ? 'Mobile Device' : 'Desktop Browser';
        
        await supabase.rpc('fn_register_active_session', {
          p_session_token: token,
          p_device_name: deviceName,
          p_user_agent: (nav.userAgent || '').substring(0, 100)
        });

        // Load active sessions
        const { data: sessData } = await supabase
          .from('user_active_sessions')
          .select('*')
          .eq('is_valid', true)
          .order('last_active', { ascending: false });

        setSessions(sessData || []);

        // Load user preferences
        const { data: secPrefs } = await supabase
          .from('user_security_settings')
          .select('*')
          .eq('user_id', session.user.id)
          .maybeSingle();

        if (secPrefs) {
          setEmailAlerts(secPrefs.email_alerts_new_device ?? true);
          setSingleSession(secPrefs.single_session_enforced ?? true);
        }
      } catch (err) {
        console.error('Security load error:', err);
      } finally {
        setLoading(false);
      }
    }

    loadSecurityData();
  }, [router]);

  // Update Password
  const handlePasswordChange = async (e) => {
    e.preventDefault();
    setPasswordMsg({ type: '', text: '' });

    if (newPassword.length < 6) {
      setPasswordMsg({ type: 'error', text: 'Password must be at least 6 characters long.' });
      return;
    }
    if (newPassword !== confirmPassword) {
      setPasswordMsg({ type: 'error', text: 'Passwords do not match.' });
      return;
    }

    setPasswordLoading(true);
    try {
      const { error } = await supabase.auth.updateUser({ password: newPassword });
      if (error) throw error;

      setPasswordMsg({ type: 'success', text: 'Password changed successfully! 🔒' });
      setNewPassword('');
      setConfirmPassword('');
    } catch (err) {
      setPasswordMsg({ type: 'error', text: err.message || 'Failed to update password.' });
    } finally {
      setPasswordLoading(false);
    }
  };

  // Toggle Security Options
  const handleTogglePref = async (key, value) => {
    if (!currentUser) return;
    try {
      if (key === 'email_alerts_new_device') setEmailAlerts(value);
      if (key === 'single_session_enforced') setSingleSession(value);

      await supabase.from('user_security_settings').upsert({
        user_id: currentUser.id,
        [key]: value,
        updated_at: new Date().toISOString()
      });
    } catch (err) {
      console.error('Settings update error:', err);
    }
  };

  // Logout Other Devices
  const handleRevokeOthers = async () => {
    if (!confirm('Are you sure you want to log out from all other devices?')) return;
    setActionLoading(true);

    try {
      await supabase.rpc('fn_revoke_other_sessions', { p_current_token: currentToken });
      setSessions((prev) => prev.filter((s) => s.session_token === currentToken));
      alert('All other devices have been logged out.');
    } catch (err) {
      alert('Failed: ' + err.message);
    } finally {
      setActionLoading(false);
    }
  };

  if (loading) {
    return (
      <div style={{ minHeight: '100vh', backgroundColor: '#070b14', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#38bdf8' }}>
        Loading security settings...
      </div>
    );
  }

  return (
    <div style={{ minHeight: '100vh', backgroundColor: '#070b14', color: '#f8fafc', fontFamily: 'system-ui, -apple-system, sans-serif', paddingBottom: '90px' }}>
      {/* Header */}
      <header style={{ padding: '0.8rem 1rem', display: 'flex', alignItems: 'center', justifyContent: 'space-between', maxWidth: '640px', margin: '0 auto', borderBottom: '1px solid #1e293b' }}>
        <button
          onClick={() => router.back()}
          style={{ background: '#0f172a', border: '1px solid #1e293b', color: '#cbd5e1', borderRadius: '10px', width: '36px', height: '36px', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center' }}
        >
          ←
        </button>
        <span style={{ fontWeight: '800', fontSize: '0.95rem' }}>Account Security</span>
        <div style={{ width: '36px' }}></div>
      </header>

      <main style={{ maxWidth: '640px', margin: '0 auto', padding: '1.2rem 1rem', display: 'flex', flexDirection: 'column', gap: '1.2rem' }}>
        {/* Verification Status */}
        <div style={{ backgroundColor: '#0f172a', border: '1px solid #1e293b', borderRadius: '14px', padding: '1rem', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          <div>
            <div style={{ fontSize: '0.88rem', fontWeight: '700', color: '#fff' }}>Email Verification</div>
            <div style={{ fontSize: '0.75rem', color: '#94a3b8', marginTop: '2px' }}>{currentUser?.email}</div>
          </div>
          <span style={{ backgroundColor: 'rgba(34, 197, 94, 0.15)', color: '#22c55e', border: '1px solid rgba(34, 197, 94, 0.4)', borderRadius: '20px', padding: '0.2rem 0.65rem', fontSize: '0.72rem', fontWeight: '700' }}>
            ✓ Verified
          </span>
        </div>

        {/* Change Password Box */}
        <div style={{ backgroundColor: '#0f172a', border: '1px solid #1e293b', borderRadius: '14px', padding: '1.1rem' }}>
          <div style={{ fontSize: '0.92rem', fontWeight: '800', color: '#fff', marginBottom: '0.9rem', display: 'flex', alignItems: 'center', gap: '0.45rem' }}>
            <span>🔑</span> Change Password
          </div>

          <form onSubmit={handlePasswordChange} style={{ display: 'flex', flexDirection: 'column', gap: '0.75rem' }}>
            <input
              type="password"
              placeholder="New password (min 6 chars)"
              value={newPassword}
              onChange={(e) => setNewPassword(e.target.value)}
              required
              style={{ backgroundColor: '#1e293b', border: '1px solid #334155', borderRadius: '10px', padding: '0.55rem 0.85rem', color: '#fff', fontSize: '0.82rem', outline: 'none' }}
            />
            <input
              type="password"
              placeholder="Confirm new password"
              value={confirmPassword}
              onChange={(e) => setConfirmPassword(e.target.value)}
              required
              style={{ backgroundColor: '#1e293b', border: '1px solid #334155', borderRadius: '10px', padding: '0.55rem 0.85rem', color: '#fff', fontSize: '0.82rem', outline: 'none' }}
            />

            {passwordMsg.text && (
              <div style={{ color: passwordMsg.type === 'success' ? '#22c55e' : '#ef4444', fontSize: '0.75rem', fontWeight: '600' }}>
                {passwordMsg.text}
              </div>
            )}

            <button
              type="submit"
              disabled={passwordLoading}
              style={{ backgroundColor: '#0284c7', color: '#fff', border: 'none', borderRadius: '10px', padding: '0.6rem', fontSize: '0.82rem', fontWeight: '700', cursor: passwordLoading ? 'wait' : 'pointer', marginTop: '0.2rem' }}
            >
              {passwordLoading ? 'Updating Password...' : 'Save New Password'}
            </button>
          </form>
        </div>

        {/* Protection Policies */}
        <div style={{ backgroundColor: '#0f172a', border: '1px solid #1e293b', borderRadius: '14px', padding: '1.1rem', display: 'flex', flexDirection: 'column', gap: '0.9rem' }}>
          <div style={{ fontSize: '0.92rem', fontWeight: '800', color: '#fff' }}>Security Options</div>

          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div>
              <div style={{ fontSize: '0.82rem', fontWeight: '700', color: '#fff' }}>Single Active Session</div>
              <div style={{ fontSize: '0.72rem', color: '#94a3b8' }}>Logging in on a new device will sign out older devices.</div>
            </div>
            <input
              type="checkbox"
              checked={singleSession}
              onChange={(e) => handleTogglePref('single_session_enforced', e.target.checked)}
              style={{ accentColor: '#0284c7', width: '18px', height: '18px', cursor: 'pointer' }}
            />
          </div>

          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #1e293b', paddingTop: '0.8rem' }}>
            <div>
              <div style={{ fontSize: '0.82rem', fontWeight: '700', color: '#fff' }}>New Device Login Alerts</div>
              <div style={{ fontSize: '0.72rem', color: '#94a3b8' }}>Get notifications whenever your account is accessed from a new device.</div>
            </div>
            <input
              type="checkbox"
              checked={emailAlerts}
              onChange={(e) => handleTogglePref('email_alerts_new_device', e.target.checked)}
              style={{ accentColor: '#0284c7', width: '18px', height: '18px', cursor: 'pointer' }}
            />
          </div>
        </div>

        {/* Active Devices List */}
        <div style={{ backgroundColor: '#0f172a', border: '1px solid #1e293b', borderRadius: '14px', padding: '1.1rem' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.9rem' }}>
            <div style={{ fontSize: '0.92rem', fontWeight: '800', color: '#fff' }}>My Active Sessions</div>
            {sessions.length > 1 && (
              <button
                type="button"
                onClick={handleRevokeOthers}
                disabled={actionLoading}
                style={{ background: 'none', border: 'none', color: '#ef4444', fontSize: '0.75rem', fontWeight: '700', cursor: 'pointer' }}
              >
                Logout Others
              </button>
            )}
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: '0.65rem' }}>
            {sessions.map((sess) => {
              const isCurrent = sess.session_token === currentToken;
              return (
                <div
                  key={sess.id}
                  style={{
                    backgroundColor: isCurrent ? '#111e38' : '#1e293b',
                    border: isCurrent ? '1px solid #0284c7' : '1px solid #334155',
                    borderRadius: '10px',
                    padding: '0.75rem 0.9rem',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'space-between'
                  }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', gap: '0.65rem' }}>
                    <span style={{ fontSize: '1.2rem' }}>{sess.device_name?.includes('Mobile') ? '📱' : '💻'}</span>
                    <div>
                      <div style={{ fontSize: '0.82rem', fontWeight: '700', color: '#fff' }}>
                        {sess.device_name || 'Active Session'} {isCurrent && <span style={{ color: '#38bdf8', fontSize: '0.72rem' }}>(This device)</span>}
                      </div>
                      <div style={{ fontSize: '0.68rem', color: '#94a3b8' }}>
                        Last active: {new Date(sess.last_active).toLocaleString()}
                      </div>
                    </div>
                  </div>

                  <span style={{ fontSize: '0.7rem', color: isCurrent ? '#22c55e' : '#94a3b8', fontWeight: '600' }}>
                    {isCurrent ? '● Active' : 'Authorized'}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      </main>
    </div>
  );
}
